
{
  "version": "0.2.0",
  "configurations": [
      {
          "name": "Launch Python with C++ Debug",
          "type": "cppdbg",
          "request": "launch",
          "program": "/root/miniconda3/envs/hanabi/bin/python",
          "args": [
              "${workspaceFolder}/pyhanabi/selfplay.py"
          ],
          "stopAtEntry": false,
          "cwd": "${workspaceFolder}",
          "environment": [],
          "externalConsole": false,
          "MIMode": "gdb",
          "miDebuggerPath": "/root/miniconda3/envs/hanabi/bin/gdb",
          "setupCommands": [
              {
                  "description": "Enable pretty-printing for gdb",
                  "text": "-enable-pretty-printing",
                  "ignoreFailures": true
              },
              {
                "description": "Set Python extension debug flag",
                "text": "-gdb-set python print-stack true",
                "ignoreFailures": true
              }
          ],
          "logging": { "moduleLoad": true }
      },
      {
          "name": "Attach to Python Process",
          "type": "cppdbg",
          "request": "attach",
          "program": "/root/miniconda3/envs/hanabi/bin/python",
          "processId": "${command:pickProcess}",
          "MIMode": "gdb",
          "miDebuggerPath": "/root/miniconda3/envs/hanabi/bin/gdb"
      }
  ]
}



